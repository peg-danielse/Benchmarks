# dtn-01: 64 CPUs. Mercury on CPU 0, pool 1-59. Check that Kurt's runs (Mercury on 8080, ports 18180-18199) are finished first.
# Values here only apply when the environment does not set them; run-demo.sh options win over both.
DSB_ROOT=/home/paul/Benchmarks
MERCURY_ROOT=/home/paul/Mercury
MERCURY_PORT=28080
MERCURY_CPU=0
POOL=1-59
DEMO_APPS=hotel social      # or hotel,hotel (instances hotel-a, hotel-b)
HOTEL_HOMES=1-15            # one home per hotel daemon
SOCIAL_HOMES=16-33          # one home per social daemon
HOTEL_GEN_CPU=58
SOCIAL_GEN_CPU=59
HOTEL_GEN_MAX=8
SOCIAL_GEN_MAX=8
HOTEL_SVC_MAX=16
SOCIAL_SVC_MAX=16
HOTEL_OP_CPU=60
SOCIAL_OP_CPU=61
HOTEL_JAEGER_CPUS=62
SOCIAL_JAEGER_CPUS=63
HOTEL_JAEGER_OFFSET=20000
SOCIAL_JAEGER_OFFSET=21000
# two hotels (DEMO_APPS=hotel,hotel): hotel-b adds HOTEL_B_PORT_OFFSET to every port
HOTEL_A_HOMES=1-15
HOTEL_B_HOMES=16-33
HOTEL_A_GEN_CPU=58
HOTEL_B_GEN_CPU=59
HOTEL_A_OP_CPU=60
HOTEL_B_OP_CPU=61
HOTEL_A_JAEGER_CPUS=62
HOTEL_B_JAEGER_CPUS=63
HOTEL_A_JAEGER_OFFSET=20000
HOTEL_B_JAEGER_OFFSET=21000
HOTEL_A_PORT_OFFSET=0
HOTEL_B_PORT_OFFSET=2000
HOTEL_A_PHASE=0
HOTEL_B_PHASE=180
JAEGER=0
TRACE_SAMPLE=0.02
SOCIAL_MONGO=own
SOCIAL_MONGO_PORT=27018
SOCIAL_LIB_DIR=
SOCIAL_REDIS_BIN=
SOCIAL_RABBITMQ_SERVER=
SOCIAL_ERLANG_BIN=
POLICY=saturate
DEMO_PERIOD=10m
DEMO_PERIODS=2
DEMO_USERS_MIN=50
DEMO_USERS_MAX=150
# DEMO_USERS_MEAN=100      # alternative to min/max (DEMO_USERS_AMP defaults to mean/2)
# DEMO_USERS_AMP=50
DEMO_STEP=5s
DEMO_RAMP_IN=30s
HOTEL_PHASE=0
SOCIAL_PHASE=180
