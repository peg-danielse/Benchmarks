# Paul's PC "Apollo": i9-14900HX, 32 CPUs. P-cores 0-15 (SMT pairs 0-1, 2-3, ...), E-cores 16-31.
# Values here only apply when the environment does not set them; run-demo.sh options win over both.
DSB_ROOT=/home/pager/Benchmarks
MERCURY_ROOT=/home/pager/Mercury
MERCURY_PORT=28080          # not 8080
MERCURY_CPU=0               # Mercury pins itself to the lowest CPU it is given
POOL=1-27                   # daemon pool (homes + growth + loadgen homes)
DEMO_APPS=hotel,hotel       # two hotels (hotel-a, hotel-b); "hotel social" once social runs here
# two hotels: hotel-a stock ports, hotel-b every port +HOTEL_B_PORT_OFFSET (6000.. would hit X11, so 2000)
HOTEL_A_HOMES=1-7           # 15 daemons round-robin on P-threads 1-7
HOTEL_B_HOMES=8-15          # 15 daemons round-robin on P-threads 8-15
HOTEL_A_GEN_CPU=16          # loadgen homes on E-cores (inside POOL)
HOTEL_B_GEN_CPU=20
HOTEL_A_OP_CPU=28           # orchestrators outside the pool
HOTEL_B_OP_CPU=29
HOTEL_A_JAEGER_CPUS=30      # bare Jaeger per instance (JAEGER=1)
HOTEL_B_JAEGER_CPUS=31
HOTEL_A_JAEGER_OFFSET=20000
HOTEL_B_JAEGER_OFFSET=21000
HOTEL_A_PORT_OFFSET=0
HOTEL_B_PORT_OFFSET=2000
HOTEL_A_PHASE=0
HOTEL_B_PHASE=180
DEMO_GEN_MAX=4
DEMO_SVC_MAX=8
# hotel + social (DEMO_APPS="hotel social")
HOTEL_HOMES=1-7
SOCIAL_HOMES=8-15
HOTEL_GEN_CPU=16
SOCIAL_GEN_CPU=20
HOTEL_OP_CPU=28
SOCIAL_OP_CPU=29
HOTEL_JAEGER_CPUS=30
SOCIAL_JAEGER_CPUS=31
HOTEL_JAEGER_OFFSET=20000
SOCIAL_JAEGER_OFFSET=21000
JAEGER=1
TRACE_SAMPLE=0.02
SOCIAL_MONGO=own            # own mongod on SOCIAL_MONGO_PORT (graph loaded once: SOCIAL_INIT=auto)
SOCIAL_MONGO_PORT=27018
SOCIAL_LIB_DIR=/home/pager/Benchmarks/demo/lib   # libboost_thread 1.83 for the social binaries (Manjaro ships newer)
SOCIAL_REDIS_BIN=/home/pager/Benchmarks/demo/opt/redis-server   # redis 7.2 built from source (the pacman valkey needs a newer glibc than installed)
SOCIAL_RABBITMQ_SERVER=/home/pager/Benchmarks/demo/opt/rabbitmq_server-4.1.4/sbin/rabbitmq-server   # generic-unix 4.1.4: pacman rabbitmq 4.3.1 + OTP 29 fail (feature flags / beam_disasm)
SOCIAL_ERLANG_BIN=/home/pager/Benchmarks/demo/opt/otp-28/bin   # prebuilt OTP 28.1 (builds.hex.pm, ubuntu-22.04)
POLICY=saturate
# Load (per app: HOTEL_PERIOD, SOCIAL_USERS_MAX, ... override DEMO_*)
DEMO_PERIOD=5m
DEMO_PERIODS=2
DEMO_USERS_MIN=50
DEMO_USERS_MAX=150
# DEMO_USERS_MEAN=100      # alternative to min/max (DEMO_USERS_AMP defaults to mean/2)
# DEMO_USERS_AMP=50
DEMO_STEP=5s
DEMO_RAMP_IN=30s
HOTEL_PHASE=0
SOCIAL_PHASE=180
# per instance, e.g.: HOTEL_B_PERIOD=3m HOTEL_B_USERS_MAX=200 (else HOTEL_*, else DEMO_*)
