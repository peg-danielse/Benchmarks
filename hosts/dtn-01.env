# dtn-01: EPYC 7301, 64 CPUs, 2 sockets, 8 NUMA nodes (node n = CPUs 4n..4n+3 and their SMT siblings 32+4n..32+4n+3).
# Values here only apply when the environment does not set them; run-demo.sh options win over both.
# Kurt shares this host: check that nothing runs first (Mercury/ctest, operators, jaeger, stress-ng, perturb; see DEMO.md "dtn-01").
#
# Trees: the demo code lives in git worktrees of the `demo` branches (never Kurt's checkouts):
#   ~/Benchmarks/demo-wt/{hotel,social,mercury}. DSB_ROOT stays ~/Benchmarks: the stock service binaries,
#   runtime/ wrappers (memcached, mongod, redis, rabbitmq), mercury-*.txt lists and jaeger/run-jaeger.sh
#   are only read from there.
DSB_ROOT=/home/paul/Benchmarks
HOTEL_DIR=/home/paul/Benchmarks/demo-wt/hotel        # config.json + cwd of Mercury and the hotel operators
SOCIAL_DIR=/home/paul/Benchmarks/demo-wt/social      # config/service-config.json + cwd of goperate
MERCURY_ROOT=/home/paul/Benchmarks/demo-wt/mercury
MERCURY_BIN=/home/paul/Benchmarks/demo-wt/mercury/build-demo/mercury   # demo branch, own build dir (not ~/Mercury/build)
GNN_MODEL=/home/paul/Benchmarks/demo-wt/mercury/models/gnn_v3.json     # only used with --policy gnn; same bytes as ~/Mercury/models/gnn_v3.json
MERCURY_PORT=28080          # Kurt: 8080 and 18180-18199
MERCURY_CPU=0               # Mercury pins itself to the lowest CPU it is given
POOL=1-59                   # daemon pool (homes + growth + loadgen homes); 60-63 stay outside
DEMO_APPS=hotel social      # or hotel,hotel (instances hotel-a, hotel-b)
DEMO_GEN_MAX=8
DEMO_SVC_MAX=16
# hotel + social (DEMO_APPS="hotel social"): one socket-half each, physical cores only as homes
HOTEL_HOMES=1-15            # 15 hotel daemons, NUMA nodes 0-3
SOCIAL_HOMES=16-31          # 18 social daemons round-robin, NUMA nodes 4-7
HOTEL_GEN_CPU=58            # loadgen homes: separate CPUs, not in any app's homes (SMT siblings, inside POOL)
SOCIAL_GEN_CPU=59
HOTEL_OP_CPU=60             # orchestrators outside the pool
SOCIAL_OP_CPU=61
HOTEL_JAEGER_CPUS=62        # bare Jaeger per instance (JAEGER=1); 63 stays free
SOCIAL_JAEGER_CPUS=62
HOTEL_JAEGER_OFFSET=21000   # Kurt uses offset 20000
SOCIAL_JAEGER_OFFSET=22000
HOTEL_PORT_OFFSET=1000      # hotel ports +1000 (frontend 6000, services 9081-9089, memcached 12211-12214, mongod 28017):
                            # never Kurt's stock 5000/8081../11211../27017 or his mongod data dir
# two hotels (DEMO_APPS=hotel,hotel)
HOTEL_A_HOMES=1-15          # NUMA nodes 0-3
HOTEL_B_HOMES=16-30         # NUMA nodes 4-7
HOTEL_A_GEN_CPU=58
HOTEL_B_GEN_CPU=59
HOTEL_A_OP_CPU=60
HOTEL_B_OP_CPU=61
HOTEL_A_JAEGER_CPUS=62
HOTEL_B_JAEGER_CPUS=62
HOTEL_A_JAEGER_OFFSET=21000
HOTEL_B_JAEGER_OFFSET=22000
HOTEL_A_PORT_OFFSET=1000    # frontend 6000, mongod 28017
HOTEL_B_PORT_OFFSET=2000    # frontend 7000, services 10081-10089 (social uses 10001-10012), mongod 29017
HOTEL_A_PHASE=0
HOTEL_B_PHASE=180
JAEGER=1                    # --no-jaeger to switch off
TRACE_SAMPLE=0.02
# social: fixed ports 10001-10012, memcached 11311-11313, redis 6379, rabbitmq 5672 (the same as Kurt's social
# deployment: never run next to it); own mongod on a demo-only port (graph loaded once: SOCIAL_INIT=auto)
SOCIAL_MONGO=own
SOCIAL_MONGO_PORT=27028     # not 27017 (hotel/Kurt) or 27018/27021-27023 (existing data dirs)
SOCIAL_LIB_DIR=             # dtn-01's packages work with the stock social binaries
SOCIAL_REDIS_BIN=
SOCIAL_RABBITMQ_SERVER=
SOCIAL_ERLANG_BIN=
POLICY=saturate
DEMO_PERIOD=10m
DEMO_PERIODS=2
DEMO_USERS_MIN=50
DEMO_USERS_MAX=150
# DEMO_USERS_MEAN=100      # alternative to min/max (DEMO_USERS_AMP defaults to mean/2)
# DEMO_USERS_AMP=50
DEMO_STEP=5s
DEMO_RAMP_IN=30s
HOTEL_PHASE=0
SOCIAL_PHASE=180
